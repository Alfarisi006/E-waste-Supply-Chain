Desired integration=MIN(1, 0.2 + 0.3 * Stakeholder collaboration+ 0.25 * Regulatory enforcement\
		+ 0.2 * Economic incentives + 0.15 * Occupational health and safety)
	~	Dmnl
	~		|

Scenario regulatory enforcement=0.3
	~	Dmnl
	~		|

Lifecycle extension=MIN(1, Base lifecycle extension+ 0.3 * Policy effectiveness+ 0.25\
		 * Data transparency and traceability+ 0.2 * Social inclusion of informal workers
	)
	~	Dmnl
	~		|

Formal recovery efficiency=MIN(0.9, Base formal recovery efficiency+ 0.2 * Technology adoption index\
		 + 0.1 * Data transparency and traceability)
	~	Dmnl
	~		|

Scenario economic incentives=0.25
	~	Dmnl
	~		|

Capacity addition=Investment attractiveness*MAX(Max capacity addition, Capacity programme switch\
		 * STEP(1, Policy start year) * Formal capacity gap / Capacity adjustment time)
	~	Ton/Year/Year
	~	Without the capacity programme (switch = 0) capacity addition is bounded by Max capacity addition; with the programme (switch = 1, from 2025) investment also responds to the formal capacity gap.
	|

Formal capacity gap=MAX(0, "Collected E-waste stock" * Formal processing share / Processing time - Formal recycling capacity)
	~	Ton/Year
	~		|

Capacity programme switch=0
	~	Dmnl
	~	0 = no programme; 1 = demand-responsive capacity programme (scenario ICT + Capacity Programme).
	|

Capacity adjustment time=10
	~	Year
	~	Time to plan, finance, permit and build formal capacity (sensitivity range 5-20).
	|

Policy start year=2025
	~	Year
	~		|

Implementation period=5
	~	Year
	~	Years over which the scenario inputs are phased in (2025-2030).
	|

Scenario EPR Implementation=0.25
	~	Dmnl
	~		|

Investment attractiveness=MIN(1, 0.2 + 0.25 * Economic incentives+ 0.25 * Policy effectiveness\
		+ 0.2 * Stakeholder collaboration + 0.1 * Data transparency and traceability)
	~	Dmnl
	~		|

Scenario stakeholder collaboration=0.3
	~	Dmnl
	~		|

Scenario access to clean technology=0.25
	~	Dmnl
	~		|

Technology adoption index=MIN(1, 0.4 * Access to clean technology + 0.35 * Technological upgrading capability\
		+ 0.25 * Economic incentives)
	~	Dmnl
	~		|

Pollution control practices=MIN(0.9,0.15 + 0.3 * Access to clean technology+ 0.25 * Regulatory enforcement\
		+ 0.2 * Technology adoption index
	)
	~	Dmnl
	~		|

Access to clean technology=Historical access to clean technology + (Scenario access to clean technology - Historical access to clean technology) * RAMP(1 / Implementation period, Policy start year\
		, Policy start year + Implementation period)
	~	Dmnl
	~	Historical value until 2024; phased in linearly to the scenario value over the implementation period.
	|

Historical access to clean technology=0.25
	~	Dmnl
	~	Policy setting 2016-2024 (equal to BAU).
	|

Integration adjustment time=4
	~	Year
	~		|

Integration erosion=Social inclusion of informal workers* (1 - Stakeholder collaboration\
		) / Integration erosion time
	~	1/Year
	~		|

Integration erosion time=10
	~	Year
	~		|

Integration improvement=MAX ( 0 , (Desired integration-Social inclusion of informal workers\
		)/Integration adjustment time )
	~	1/Year
	~		|

Leakage fraction=MAX(Minimum leakage fraction,Base leakage fraction* (1 - 0.5 * Regulatory enforcement)* \
		(1 - 0.3 * Collection and reverse logistics efficiency))
	~	1/Year
	~		|

Formal processing share=MIN(0.95, Base formal share+ 0.25 * Regulatory enforcement+ 0.2\
		 * EPR Implementation+ 0.25 * Social inclusion of informal workers
	+ 0.15 * Access to clean technology)
	~	Dmnl
	~		|

Technological upgrading capability=MIN(1, 0.25 + 0.3 * Economic incentives+ 0.3 * Access to clean technology\
		+ 0.15 * Data transparency and traceability)
	~	Dmnl
	~		|

Collection and reverse logistics efficiency=MIN(0.95, Base collection efficiency+ 0.25\
		 * Reverse logistics efficiency + 0.2 * Social inclusion of informal workers
	+ 0.15 * Data transparency and traceability)
	~	Dmnl
	~		|

Occupational health and safety=MIN(1, 0.2 + 0.3 * Regulatory enforcement+ 0.25 * Social inclusion of informal workers\
		+ 0.25 * Access to clean technology)
	~	Dmnl
	~		|

Informal recovery efficiency=MAX(0.2, Base informal recovery efficiency+ 0.1 * Social inclusion of informal workers\
		- 0.1 * Regulatory restriction effect
	)
	~	Dmnl
	~		|

Policy effectiveness=MIN(1, 0.35 * Regulatory enforcement+ 0.3 * EPR Implementation+ \
		0.35 * Stakeholder collaboration)
	~	Dmnl
	~		|

EPR Implementation=Historical EPR implementation + (Scenario EPR Implementation - Historical EPR implementation) * RAMP(1 / Implementation period, Policy start year\
		, Policy start year + Implementation period)
	~	Dmnl
	~	Historical value until 2024; phased in linearly to the scenario value over the implementation period.
	|

Historical EPR implementation=0.25
	~	Dmnl
	~	Policy setting 2016-2024 (equal to BAU).
	|

Data transparency and traceability=MIN(1, 0.2 + 0.3 * Stakeholder collaboration+ 0.25\
		 * EPR Implementation+ 0.2 * Regulatory enforcement)
	~	Dmnl
	~		|

Reverse logistics efficiency=MIN(1, 0.25 + 0.3 * Stakeholder collaboration + 0.2 * Economic incentives\
		+ 0.15 * Data transparency and traceability
	)
	~	Dmnl
	~		|

Economic incentives=Historical economic incentives + (Scenario economic incentives - Historical economic incentives) * RAMP(1 / Implementation period, Policy start year\
		, Policy start year + Implementation period)
	~	Dmnl
	~	Historical value until 2024; phased in linearly to the scenario value over the implementation period.
	|

Historical economic incentives=0.25
	~	Dmnl
	~	Policy setting 2016-2024 (equal to BAU).
	|

Regulatory restriction effect=Regulatory enforcement * (1 - Social inclusion of informal workers\
		)
	~	Dmnl
	~		|

Regulatory enforcement=Historical regulatory enforcement + (Scenario regulatory enforcement - Historical regulatory enforcement) * RAMP(1 / Implementation period, Policy start year\
		, Policy start year + Implementation period)
	~	Dmnl
	~	Historical value until 2024; phased in linearly to the scenario value over the implementation period.
	|

Historical regulatory enforcement=0.3
	~	Dmnl
	~	Policy setting 2016-2024 (equal to BAU).
	|

Stakeholder collaboration=Historical stakeholder collaboration + (Scenario stakeholder collaboration - Historical stakeholder collaboration) * RAMP(1 / Implementation period, Policy start year\
		, Policy start year + Implementation period)
	~	Dmnl
	~	Historical value until 2024; phased in linearly to the scenario value over the implementation period.
	|

Historical stakeholder collaboration=0.3
	~	Dmnl
	~	Policy setting 2016-2024 (equal to BAU).
	|

Annual CO2 reduction=Virgin material displacement * Emission factor avoided virgin material\
		 - Formal processing flow * Emission factor formal recycling - Informal processing flow\
		 * Emission factor informal recycling
	~	Kg CO2 Eq/Year
	~		|

Minimum leakage fraction=0.02
	~	1/Year
	~	Lower bound of the leakage fraction (previously a numeric literal; value unchanged).
	|

Base collection efficiency=0.35
	~	Dmnl
	~		|

Saturation level=3.90284e+06
	~	Ton/Year
	~	Logistic saturation level of potential e-waste generation in Indonesia, fitted to GEM data 2016, 2019, 2022 and the 2040 projection of Mairizal et al. (2021).
	|

Inflection year=2020.51
	~	Year
	~	Fitted.
	|

Base formal recovery efficiency=0.6
	~	Dmnl
	~		|

Base formal share=0.25
	~	Dmnl
	~		|

Base informal recovery efficiency=0.4
	~	Dmnl
	~		|

Base leakage fraction=0.08
	~	1/Year
	~		|

Base lifecycle extension=0.15
	~	Dmnl
	~		|

Capacity depreciation=Formal recycling capacity/Capacity lifetime
	~	Ton/Year/Year
	~		|

Capacity lifetime=15
	~	Year
	~		|

"Collected E-waste stock"= INTEG (Collection flow-Formal processing flow-Informal processing flow\
		,
		"Initial collected E-waste")
	~	Ton
	~		|

Collection flow="E-waste stock" * Collection and reverse logistics efficiency / Collection Time
	~	Ton/Year
	~		|

Collection Time=1
	~	Year
	~		|

Logistic growth rate=0.1211
	~	1/Year
	~	Fitted.
	|

Cumulative CO2 Reduction= INTEG (Annual CO2 reduction * STEP(1, Policy start year),
		0)
	~	Kg CO2 Eq
	~		|

Disposal pollution factor=0.012
	~	Pollution index/Ton
	~		|

"E-waste generation"=Saturation level / (1 + EXP( - Logistic growth rate * (Time - Inflection year)))\
		 * (1 - Life cycle extension effect)
	~	Ton/Year
	~		|

"E-waste stock"= INTEG ("E-waste generation"-Collection flow-Leakage to uncontrolled disposal\
		,
		"Initial E-waste stock")
	~	Ton
	~		|

Emission factor avoided virgin material=2500
	~	Kg CO2 Eq/Ton
	~		|

Emission factor formal recycling=500
	~	Kg CO2 Eq/Ton
	~		|

Emission factor informal recycling=900
	~	Kg CO2 Eq/Ton
	~		|

Formal pollution factor=0.002
	~	Pollution index/Ton
	~		|

Formal processing flow=MIN("Collected E-waste stock" * Formal processing share/ Processing time\
		,Formal recycling capacity
	)
	~	Ton/Year
	~		|

Formal recycling capacity= INTEG (Capacity addition-Capacity depreciation,
		Initial formal recycling capacity)
	~	Ton/Year
	~		|

Informal pollution factor=0.01
	~	Pollution index/Ton
	~		|

Informal processing flow=MAX(0,"Collected E-waste stock" / Processing time - Formal processing flow\
		)
	~	Ton/Year
	~		|

Social inclusion of informal workers= INTEG (Integration improvement-Integration erosion\
		,
		Initial Social inclusion of informal workers)
	~	Dmnl
	~		|

