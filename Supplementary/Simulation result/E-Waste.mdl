{UTF-8}
"Base E-waste"=3.3
	~	Mt/yr
	~		|

Base formal collection fraction=0.05
	~	1/yr
	~		|

Base informal collection fraction=0.4
	~	1/yr
	~		|

Carbon Avoidance Rate=Material Recovery Rate* Carbon saving pertonne * Recovery Quality Factor\
		 + MAX(0, (Lifecycle extension through reuse and repair- 0.5) * 2) * "E-waste Inflow"\
		 * Lifecycle carbon saving
	~	
	~		|

Carbon Avoided Cumulative= INTEG (Carbon Avoidance Rate,
		0)
	~	
	~		|

Carbon Emission Cumulative= INTEG (Carbon Emission Rate,
		0)
	~	
	~		|

Carbon Emission Rate=Collection Outflow* Emission factor informal base* (1 - 0.7 * Technological upgrading capability\
		)
	~	
	~		|

Carbon saving pertonne=4.5
	~	tCO2/t
	~		|

Pollution control and environmental practices Level=MIN(1, Regulatory Enforcement strength Level\
		* 0.4 + Technological upgrading capability* 0.6)
	~	
	~		|

Collection Outflow="E-Waste Stock" * (Base informal collection fraction* Collection and reverse logistics efficiency\
		+ Base formal collection fraction* Regulatory Enforcement strength Level* Technological upgrading capability\
		) + "E-Waste Stock" * Informal–formal sector integration* 0.02
	~	
	~		|

Data transparency and traceability Level=MIN(1, Stakeholder Collab Level* 0.55 + Collection and reverse logistics efficiency\
		* 0.45)
	~	
	~		|

"E-waste growth rate"=0.04
	~	1/yr
	~		|

"E-waste Inflow"="Base E-waste" * EXP("E-waste growth rate" * Time) * MAX(0, 1 - Lifecycle extension through reuse and repair\
		* 0.15)
	~	
	~		|

"E-Waste Stock"= INTEG ("E-waste Inflow"-Collection Outflow,
		5.5)
	~	
	~		|

Recovery Quality Factor=MIN(1, 0.3 + 0.5 * Technological upgrading capability+ 0.2 * \
		Collection and reverse logistics efficiency)
	~	
	~		|

Emission factor informal base=3.5
	~	tCO2/t
	~		|

Lifecycle carbon saving=0.8
	~	tCO2/t
	~		|

Social inclusion of informal workers LEvel=MIN(1, Stakeholder Collab Level* 0.45 + Economic incentives and financial support\
		* 0.4 + Informal–formal sector integration* 0.15)
	~	
	~		|

Occupational health and safety conditions Level=MIN(1, Regulatory Enforcement strength Level\
		* 0.5 + Technological upgrading capability* 0.5)
	~	
	~		|

Net Carbon Balance=Carbon Avoided Cumulative-Carbon Emission Cumulative
	~	
	~		|

Lifecycle extension through reuse and repair=MIN(1, Economic incentives and financial support\
		* 0.55 + Social inclusion of informal workers LEvel* 0.45)
	~	
	~		|

Clean Tech Access Level=0.7
	~	
	~		|

Economic incentives and financial support= INTEG (Incentive Growth - Incentive Decay,
		0.3)
	~	
	~		|

EPR Implementation=0.35
	~	
	~		|

Incentive Decay=Economic incentives and financial support*Incentive Decay Rate
	~	
	~		|

Incentive Decay Rate=0.06
	~	
	~		|

Incentive Growth=Revenue from Recovery/ 1000 * 0.15 * (1 - Economic incentives and financial support\
		) + Regulatory Enforcement strength Level* 0.08 * (1 - Economic incentives and financial support\
		) + Stakeholder Collab Level* 0.07 * (1 - Economic incentives and financial support\
		) + EPR Implementation* 0.03 * (1 - Economic incentives and financial support)
	~	
	~		|

Informal–formal sector integration=0.5
	~	
	~		|

Logistic decay=Logistic decay rate*Collection and reverse logistics efficiency
	~	
	~		|

Logistic decay rate=0.04
	~	
	~		|

Collection and reverse logistics efficiency= INTEG (Logistics Improvement- Logistic decay\
		,
		0.45)
	~	
	~		|

Logistics Improvement=Technological upgrading capability* 0.1 * (1 - Collection and reverse logistics efficiency\
		) + Regulatory Enforcement strength Level* 0.08 * (1  - Collection and reverse logistics efficiency\
		) + Economic incentives and financial support* 0.06 * (1 - Collection and reverse logistics efficiency\
		) + Informal–formal sector integration* 0.03 * (1 - Collection and reverse logistics efficiency\
		)
	~	
	~		|

Material Recovery Rate=Collection Outflow* (0.5 + 0.3 * Material recovery efficiency+\
		 0.2 * Technological upgrading capability)
	~	
	~		|

Recovery Decay=Recovery Decay Rate*Material recovery efficiency
	~	
	~		|

Recovery Decay Rate=0.04
	~	
	~		|

Recovery Improvement=Technological upgrading capability* 0.12 * (1 - Material recovery efficiency\
		) + Collection and reverse logistics efficiency* 0.1 * (1 - Material recovery efficiency\
		) + Clean Tech Access Level* 0.08 * (1 - Material recovery efficiency)
	~	
	~		|

Material recovery efficiency= INTEG (Recovery Improvement - Recovery Decay,
		0.4)
	~	
	~		|

Regulatory Enforcement strength Level=0.75
	~	
	~		|

Revenue from Recovery=Material Recovery Rate*Secondary Material Price
	~	
	~		|

Secondary Material Price=800
	~	
	~		|

Stakeholder Collab Level=0.65
	~	
	~		|

Tech adoption rate=Clean Tech Access Level* 0.12 * (1 - Technological upgrading capability\
		) + Economic incentives and financial support* 0.08 * (1 - Technological upgrading capability\
		) + Regulatory Enforcement strength Level* 0.05 * (1 - Technological upgrading capability\
		)
	~	
	~		|

Tech depreciation=Tech Depreciation Rate*Technological upgrading capability
	~	
	~		|

Tech Depreciation Rate=0.05
	~	
	~		|

Technological upgrading capability= INTEG (Tech adoption rate - Tech depreciation,
		0.25)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 75
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

